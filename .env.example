# HireFlow Model Training Environment Variables
# Copy this file to .env and fill in your values

# HuggingFace Configuration
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_USERNAME=your_username

# Model Configuration
BASE_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
CURRENT_MODEL_ID=somriksur/HireFlow-Qwen-Fresh-Pro
IMPROVED_MODEL_ID=somriksur/HireFlow-Qwen-Fresh-Pro-Improve

# Training Configuration
TRAINING_DATA_SIZE=5270
TARGET_ACCURACY=90
TRAINING_TIME_HOURS=3
ENHANCEMENT_TIME_HOURS=2

# Hardware Configuration
USE_GPU=true
GPU_MEMORY_FRACTION=0.8
BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=16

# Monitoring Configuration
ENABLE_LOGGING=true
LOG_LEVEL=INFO
SAVE_CHECKPOINTS=true
CHECKPOINT_STEPS=100

# Optional: Weights & Biases Integration
WANDB_PROJECT=hireflow-model-training
WANDB_API_KEY=your_wandb_key_here

# Optional: TensorBoard Logging
TENSORBOARD_LOG_DIR=./logs
ENABLE_TENSORBOARD=false