# 🔹 Hugging Face (Custom Model via FREE Proxy)
HUGGINGFACE_ENDPOINT_URL=http://localhost:8000

# 🔹 Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="your-private-key"

# 🔹 Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# 🔹 Vapi Voice API
VAPI_API_KEY=your-vapi-key
NEXT_PUBLIC_VAPI_WEB_TOKEN=your-vapi-token
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-assistant-id

# 🔹 App Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 🔹 Groq AI (for answer evaluation)
GROQ_API_KEY=your-groq-key

# 🔹 Resend Email Service
RESEND_API_KEY=your-resend-key

# 🔹 Email Configuration
# Development Mode: When true, all emails redirect to DEV_EMAIL for testing
# Production Mode: When false, emails send to actual recipients (requires verified domain)
EMAIL_DEV_MODE=true
DEV_EMAIL=your-test-email@gmail.com

# 🔹 Email Sender Configuration (Required for production mode)
# VERIFIED_DOMAIN: Your verified domain from Resend (e.g., yourdomain.com)
# SENDER_EMAIL: Email address to send from (e.g., noreply@yourdomain.com)
# SENDER_NAME: Display name for sender (default: HireFlow)
# VERIFIED_DOMAIN=yourdomain.com
# SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=HireFlow

# 💡 To send emails to ANY address:
# 1. Get a free domain from Freenom or use your own
# 2. Verify domain at https://resend.com/domains
# 3. Set VERIFIED_DOMAIN and SENDER_EMAIL above
# 4. Set EMAIL_DEV_MODE=false
